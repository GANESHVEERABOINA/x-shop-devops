pipeline {

    agent any

    environment {
        GIT_URL           = 'https://github.com/GANESHVEERABOINA/x-shop-devops.git'
        GIT_BRANCH        = 'main'

        SCANNER_HOME      = tool 'sonar-scanner'
        SONAR_URL         = 'http://localhost:9000'
        SONAR_PROJECT_KEY = 'x-shop'
        SONAR_TOKEN       = credentials('sonar_globle_token')

        APP_NAME          = 'x-shop-three-tire-app'
        IMAGE_VERSION     = 'v6'

        DOCKER_USERNAME   = 'ganeshveeraboina'
        DOCKER_CREDS      = credentials('Docker_Login')
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_URL}"
                echo 'Repo cloned successfully'
            }
        }

        stage('SonarQube Code Analysis') {
            parallel {
                stage('Sonar - Backend') {
                    steps {
                        dir('backend') {
                            sh """
                                ${SCANNER_HOME}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY}-backend \
                                -Dsonar.projectName=${SONAR_PROJECT_KEY}-backend \
                                -Dsonar.sources=. \
                                -Dsonar.host.url=${SONAR_URL} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.exclusions=**/node_modules/**,**/dist/**
                            """
                        }
                    }
                }

                stage('Sonar - Frontend') {
                    steps {
                        dir('frontend') {
                            sh """
                                ${SCANNER_HOME}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY}-frontend \
                                -Dsonar.projectName=${SONAR_PROJECT_KEY}-frontend \
                                -Dsonar.sources=. \
                                -Dsonar.host.url=${SONAR_URL} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.exclusions=**/node_modules/**,**/dist/**
                            """
                        }
                    }
                }

                stage('Sonar - Admin') {
                    steps {
                        dir('admin') {
                            sh """
                                ${SCANNER_HOME}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY}-admin \
                                -Dsonar.projectName=${SONAR_PROJECT_KEY}-admin \
                                -Dsonar.sources=. \
                                -Dsonar.host.url=${SONAR_URL} \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.exclusions=**/node_modules/**,**/dist/**
                            """
                        }
                    }
                }
            }
        }

        stage('Test & Build') {
            parallel {
                stage('Test-Build-Backend') {
                    steps {
                        dir('backend') {
                            sh 'npm ci --legacy-peer-deps '
                        }
                    }
                }

                stage('Test-Build-Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci --legacy-peer-deps && npm run build'
                        }
                    }
                }

                stage('Test-Build-Admin') {
                    steps {
                        dir('admin') {
                            sh 'npm ci --legacy-peer-deps && npm run build'
                        }
                    }
                }
            }
        }

        stage('Dockerize') {
            parallel {
                stage('Docker - Backend') {
                    steps {
                        dir('backend') {
                            sh "docker image build -t ${DOCKER_USERNAME}/${APP_NAME}:backend-${IMAGE_VERSION} --no-cache -f Dockerfile ."
                        }
                    }
                }

                stage('Docker - Frontend') {
                    steps {
                        dir('frontend') {
                            sh "docker image build -t ${DOCKER_USERNAME}/${APP_NAME}:frontend-${IMAGE_VERSION} --no-cache -f Dockerfile ."
                        }
                    }
                }

                stage('Docker - Admin') {
                    steps {
                        dir('admin') {
                            sh "docker image build -t ${DOCKER_USERNAME}/${APP_NAME}:admin-${IMAGE_VERSION} --no-cache -f Dockerfile ."
                        }
                    }
                }
            }
        }

        stage('Scan Docker Image') {
            steps {
                sh """
                    trivy image --exit-code 0 ${DOCKER_USERNAME}/${APP_NAME}:backend-${IMAGE_VERSION}  > backend_image.txt  || true
                    trivy image --exit-code 0 ${DOCKER_USERNAME}/${APP_NAME}:frontend-${IMAGE_VERSION} > frontend_image.txt || true
                    trivy image --exit-code 0 ${DOCKER_USERNAME}/${APP_NAME}:admin-${IMAGE_VERSION}    > admin_image.txt    || true
                """
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh 'echo "$DOCKER_CREDS_PSW" | docker login -u "$DOCKER_CREDS_USR" --password-stdin'
                sh """
                    docker image push ${DOCKER_USERNAME}/${APP_NAME}:backend-${IMAGE_VERSION}
                    docker image push ${DOCKER_USERNAME}/${APP_NAME}:frontend-${IMAGE_VERSION}
                    docker image push ${DOCKER_USERNAME}/${APP_NAME}:admin-${IMAGE_VERSION}
                """
                echo 'Images pushed successfully'
                sh 'docker logout || true'
            }
        }

        stage('Deploy to K3s Using Helm') {
            steps {
                withCredentials([file(credentialsId: 'k8s_kube_config', variable: 'KUBECONFIG')]) {
                    dir('K8s-Helm') {
                        sh '''
                            helm upgrade --install backend-release  ./backend --wait --timeout 5m
                            helm upgrade --install frontend-release ./frontend --wait --timeout 5m
                            helm upgrade --install admin-release    ./admin    --wait --timeout 5m
                            helm upgrade --install ingress-release  ./ingress
                        '''
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: '*_image.txt', allowEmptyArchive: true
        }
        success {
            withCredentials([string(credentialsId: 'slack_notifier', variable: 'SLACK_URL')]) {
                sh '''
                    curl -X POST -H "Content-type: application/json" --data '{"text":"✅ *SUCCESS:* Job '"$JOB_NAME"' (Build #'"$BUILD_NUMBER"') deployed to K3s! Logs: '"$BUILD_URL"'"}' "$SLACK_URL"
                '''
            }
        }
        failure {
            withCredentials([string(credentialsId: 'slack_notifier', variable: 'SLACK_URL')]) {
                sh '''
                    curl -X POST -H "Content-type: application/json" --data '{"text":"❌ *FAILED:* Job '"$JOB_NAME"' (Build #'"$BUILD_NUMBER"') failed! Check Console: '"$BUILD_URL"'"}' "$SLACK_URL"
                '''
            }
        }
    }
}
